# Copy this file to .env.local and fill in the values.
# Every value is optional: without them the app runs in demo mode.

# Claude API (for real AI feedback). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Firebase (for a real database). Firebase console > Project settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: use the local Firestore emulator instead of a real project (see README), e.g. 127.0.0.1:8080
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=
# Optional: the local Auth emulator, e.g. 127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# Server only (never NEXT_PUBLIC_): Firebase service account JSON, for verified AI feedback and
# public portfolios. Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT=

# Server only (never NEXT_PUBLIC_): email notifications. Needs FIREBASE_SERVICE_ACCOUNT too.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail address,
# SMTP_PASS=an app password (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown in the inbox, e.g. MAntor <your-address@gmail.com>
MAIL_FROM=
# The site address used in email links, e.g. https://your-app.vercel.app (Vercel's address is used if empty)
SITE_URL=
# For trying it out locally: write emails to this file instead of sending them
MAIL_OUTBOX=
