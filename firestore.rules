rules_version = '2';

// Prototype rules: anyone can read and write until the date below, like Firebase's "test mode".
// Replace these with real rules (based on Firebase Auth) before real users sign up.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}
